{
  "name": "@buildsense/loopctl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=20" },
  "description": "Deterministic user-scoped Loop Controller for CatsCo Agent workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildsense-ai/loop-system.git",
    "directory": "controller"
  },
  "homepage": "https://github.com/buildsense-ai/loop-system#readme",
  "bugs": {
    "url": "https://github.com/buildsense-ai/loop-system/issues"
  },
  "bin": { "loopctl": "dist/cli.js" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "pnpm typecheck && pnpm test:run && pnpm build",
    "pilot:local": "pnpm build && node dist/cli.js local-pilot"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
